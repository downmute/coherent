# Runpod GPU worker example for the integrated worker service.
# For Runpod, you usually do not need to set WORKER_PUBLIC_WS_URL manually.
# If the pod exposes WORKER_PORT as an HTTP port, the worker can derive:
#   wss://<RUNPOD_POD_ID>-<WORKER_PORT>.proxy.runpod.net/ws
# automatically at startup.

SOULX_REPO_URL=https://github.com/Soul-AILab/SoulX-FlashHead.git
SOULX_REPO_REF=main
SOULX_START_MODE=service
SOULX_DIR=/opt/SoulX-FlashHead
SOULX_VENV_DIR=/opt/soulx-venv

TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
TORCH_VERSION=2.7.1
TORCHVISION_VERSION=0.22.1
FLASH_ATTN_VERSION=2.8.0.post2
SAGEATTENTION_VERSION=2.2.0
INSTALL_FLASH_ATTN=true
INSTALL_SAGEATTENTION=false
INSTALL_SOULX_EDITABLE=false
SKIP_SOULX_NCCL_PIN=true

SOULX_MODEL_ID=Soul-AILab/SoulX-FlashHead-1_3B
SOULX_MODEL_EXCLUDE_PATTERNS=Model_Pro/*
SOULX_WAV2VEC_MODEL_ID=facebook/wav2vec2-base-960h

WORKER_PORT=8090
WORKER_HOST=0.0.0.0
WORKER_KEY=
WORKER_PROVIDER=runpod
WORKER_PROVIDER_INSTANCE_ID=
WORKER_REGION=us
WORKER_GPU_MODEL=RTX4090
WORKER_MAX_SESSIONS=1
WORKER_PUBLIC_WS_URL=
WORKER_PUBLIC_BASE_URL=
WORKER_HEARTBEAT_MS=10000
CONTROL_PLANE_URL=https://coherent-control-plane.abot011235.workers.dev
WORKER_TOKEN_SECRET=CHANGE_ME

# Leave WORKER_KEY / WORKER_PROVIDER_INSTANCE_ID empty to auto-derive from
# RUNPOD_POD_ID on worker-v12+.

RTC_PROVIDER=cloudflare
RTC_ENDPOINT=https://realtime.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME
CLOUDFLARE_REALTIME_APP_ID=CHANGE_ME
CLOUDFLARE_API_TOKEN=CHANGE_ME
CLOUDFLARE_SUBSCRIBER_PRESET=group_call_participant
CLOUDFLARE_PUBLISHER_PRESET=group_call_host

WORKER_RTC_PUBLISHER=browser
WORKER_BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome
WORKER_RTC_HEADLESS=true
WORKER_RTC_VIEWPORT_WIDTH=768
WORKER_RTC_VIEWPORT_HEIGHT=768
WORKER_RTC_FPS=24
SOULX_RUNTIME_MODE=python_bridge
SOULX_DELIVERY_MODE=segment_mp4
SOULX_CHUNKS_PER_SEGMENT=1
SOULX_PREWARM_MAX_BRIDGES=2
SOULX_CKPT_DIR=/opt/SoulX-FlashHead/models/SoulX-FlashHead-1_3B
SOULX_WAV2VEC_DIR=/opt/SoulX-FlashHead/models/wav2vec2-base-960h
SOULX_MODEL_TYPE=lite
SOULX_COND_IMAGE=/opt/SoulX-FlashHead/examples/girl.png
SOULX_FACES_DIR=/app/faces
SOULX_USE_FACE_CROP=false
SOULX_BASE_SEED=9999
SOULX_PYTHON_BIN=/opt/soulx-venv/bin/python
SOULX_BRIDGE_SCRIPT=/app/scripts/soulx_stream_bridge.py
