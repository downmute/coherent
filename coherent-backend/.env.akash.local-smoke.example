# Local smoke-test env for a worker that registers with the remote control plane
# but does not try to start the real Python SoulX bridge.

WORKER_PORT=8090
WORKER_HOST=0.0.0.0
WORKER_KEY=akash-local-smoke
WORKER_PROVIDER=akash
WORKER_PROVIDER_INSTANCE_ID=
WORKER_REGION=local
WORKER_GPU_MODEL=smoke
WORKER_MAX_SESSIONS=1
WORKER_PUBLIC_WS_URL=ws://127.0.0.1:8090/ws
WORKER_HEARTBEAT_MS=10000
CONTROL_PLANE_URL=https://coherent-control-plane.abot011235.workers.dev
WORKER_TOKEN_SECRET=CHANGE_ME

# Keep the laptop path simple: no container-only Python bridge required.
SOULX_RUNTIME_MODE=mock
SOULX_DELIVERY_MODE=segment_mp4
WORKER_RTC_PUBLISHER=mock
